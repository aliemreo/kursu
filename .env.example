# Copy to .env and fill in local values. Never commit .env.

# Application
APP_ENV=development

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_USER=kursu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kursu
DATABASE_URL=postgresql://kursu:change-me@localhost:5432/kursu

# AI services: "mock" keeps the game playable without a model
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
OPPONENT_MODEL=
JUDGE_MODEL=
