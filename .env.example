# Gerçek backend'in tarayıcıdan erişilebilen adresi (yerel geliştirme).
# Docker Compose ile çalıştırırken bu değer build sırasında "/api" olarak ayarlanır.
VITE_API_BASE_URL=http://localhost:8000

# true  -> Mock API kullanılır. Backend çalışmasına gerek yoktur. Arayüzde "Mock mod" uyarısı görünür.
# false -> Gerçek backend'e (VITE_API_BASE_URL) istek atılır.
VITE_USE_MOCKS=true