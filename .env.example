# Copy to .env and fill in local values. Never commit .env.

# Application
APP_ENV=development

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_USER=kursu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kursu
DATABASE_URL=postgresql://kursu:change-me@localhost:5432/kursu

# Auth: use a long random value outside development (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# AI services: "mock" keeps the game playable without a model
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
OPPONENT_MODEL=
JUDGE_MODEL=

# Gerçek backend'in tarayıcıdan erişilebilen adresi (yerel geliştirme).
# Docker Compose ile çalıştırırken bu değer build sırasında "/api" olarak ayarlanır.
VITE_API_BASE_URL=http://localhost:8000

# true  -> Mock API kullanılır. Backend çalışmasına gerek yoktur. Arayüzde "Mock mod" uyarısı görünür.
# false -> Gerçek backend'e (VITE_API_BASE_URL) istek atılır.
VITE_USE_MOCKS=true